# Required
DISCORD_TOKEN=
# Optional but recommended: register slash commands instantly in one server
GUILD_ID=

# Support team role (defaults to the Selyn support role)
SUPPORT_ROLE_ID=1556339601067741247

# Optional: put tickets in this category, and send transcripts to this channel
TICKET_CATEGORY_ID=
LOG_CHANNEL_ID=
MAX_OPEN_PER_USER=1

# AI helper (https://console.groq.com/keys). Leave the key empty to disable the AI.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
