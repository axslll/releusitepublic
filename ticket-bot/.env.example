# Required
DISCORD_TOKEN=
# Optional but recommended: register slash commands instantly in one server
GUILD_ID=

# Support team role (defaults to the Selyn support role)
SUPPORT_ROLE_ID=1556338723958816778

# Optional: put tickets in this category, and send transcripts to this channel
TICKET_CATEGORY_ID=
LOG_CHANNEL_ID=
MAX_OPEN_PER_USER=1

# How long a staff member has to accept a ticket offered by DM before it moves on
OFFER_TIMEOUT_HOURS=3

# AI helper (https://console.groq.com/keys). Leave the key empty to disable the AI.
GROQ_API_KEY=
# Backup key: used automatically when the main one is rate limited
GROQ_API_KEY_BACKUP=
# Text-only turns use GROQ_MODEL; a message with an image switches to GROQ_VISION_MODEL for that one reply.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Anti-ping (built-in defaults shown; override with comma-separated IDs).
# Pinging these users, these roles, or anyone holding these roles deletes the message and times the pinger out.
# PROTECTED_USER_IDS=880060587697123370
# PROTECTED_ROLE_IDS=1556917397280260167,1556917485733941280
# PING_EXEMPT_ROLE_IDS=
# PING_TIMEOUT_MINUTES=5

# Chat moderation (local model, no word list). Deletes racism and strong profanity aimed at a person.
# Swearing that isn't aimed at anyone, and mild insults like "dumb" / "stupid", are left alone.
# MODERATION=off            # turn it off completely
# MODERATION_DRY_RUN=true   # only log what it WOULD delete (good for checking false positives first)
# MOD_LOG_CHANNEL_ID=       # staff channel that gets a card for every removed message
# MOD_TIMEOUT_MINUTES=0     # also time the person out (0 = just delete)
# MOD_HATE_THRESHOLD=0.5    # lower = stricter about racism
# MOD_INSULT_THRESHOLD=0.5  # lower = stricter about insults...
# MOD_OBSCENE_THRESHOLD=0.9 # ...that are also profane
# MOD_CPU_LIMIT_PERCENT=25   # pause moderation if it uses more than this % of the WHOLE machine's CPU...
# MOD_CPU_WINDOW_SECONDS=30  # ...averaged over this many seconds
# MOD_CPU_PAUSE_MINUTES=5    # ...then switch itself back on after this long
# MOD_COMMAND_ROLE_ID=1556929397087412275   # who may use /moderation on|off|status
# MOD_LOG_SCORES=true        # log EVERY checked message with its scores in the console (to tune the thresholds)
